# StudyFlow AI - OpenClaw Agent Environment Configuration

# OpenClaw Agent API Gateway URL
VITE_OPENCLAW_URL=http://localhost:8000/api/v1/agent

# OpenClaw Agent API Key (Leave blank to use built-in MockOpenClawService)
VITE_OPENCLAW_API_KEY=

# LLM Model Provider (e.g. openclaw, openai, gemini, anthropic)
VITE_AI_MODEL_PROVIDER=openclaw

# Model Identifier
VITE_AI_MODEL=claude-3-5-sonnet-20241022

# Academic Integrations Configuration
VITE_CANVAS_LMS_URL=https://canvas.instructure.com/api/v1
VITE_MS_TEAMS_TENANT_ID=
VITE_GOOGLE_CALENDAR_CLIENT_ID=
